<?xml version="1.0" encoding="utf-8"?><!--
  Snapshots are encrypted with a device-bound key, so restored data
  would be undecryptable.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="root"
            path="." />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="root"
            path="." />
    </device-transfer>
</data-extraction-rules>